# ─────────────────────────────────────────────────────────────────────────────
# Backend (.env lives in backend/.env — copy this file there and fill values)
# ─────────────────────────────────────────────────────────────────────────────

# Application
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
CLIENT_URL=http://localhost:5173

# Security
JWT_SECRET=replace-with-a-long-random-string

# Database — Supabase Postgres
# Supabase Dashboard → Project Settings → Database → Connection string → Transaction pooler.
# Format: postgres://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=
DB_SSL=true

# Test database (only if running integration tests against a real DB)
TEST_DB_NAME=
TEST_DB_USER=
TEST_DB_PASSWORD=
TEST_DB_HOST=
TEST_DB_PORT=5432

# Supabase auth
# SUPABASE_URL — Project Settings → API → Project URL (https://<project-ref>.supabase.co)
# SUPABASE_KEY — Project Settings → API → service_role key (anon key also works for the
#   current code paths, but service_role is needed if you use supabase.auth.admin.*)
SUPABASE_URL=
SUPABASE_KEY=

# Cloudinary (image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email — generic SMTP fallback
EMAIL_USER=
EMAIL_PASS=

# Email — Zoho Mail
ZOHO_MAIL_HOST=smtp.zoho.com
ZOHO_MAIL_PORT=465
ZOHO_MAIL_USER=
ZOHO_MAIL_PASSWORD=
ZOHO_MAIL_FROM=
ZOHO_MAIL_FROM_NAME=

# Email — Gmail OAuth (alternative to SMTP)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://developers.google.com/oauthplayground
GOOGLE_REFRESH_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# Frontend (.env lives in frontend/.env, prefix all vars with VITE_)
# ─────────────────────────────────────────────────────────────────────────────
VITE_REACT_APP_GOOGLE_MAPS_API_KEY=
